# Copy to .env for local development. On Railway, set these on the app service.

# Core (always required)
DATABASE_URL=postgres://bas:bas@localhost:5432/bas
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
CHECKOUT_CONTEXT_SECRET=
# "fake" replaces Paystack/Flutterwave with a local simulator at /dev/fake-gateway
# (only allowed when APP_URL is localhost). Use "live" with real (test or live) keys.
PAYMENTS_MODE=fake

# Optional locally, required in production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Build a Scent <hello@example.com>"
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Database tests (pnpm test) run against this database and reset it; never point it at real data.
TEST_DATABASE_URL=postgres://bas:bas@localhost:5432/bas_test
